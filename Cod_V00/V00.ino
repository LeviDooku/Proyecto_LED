// Array of frames stored in PROGMEM
const uint32_t* frames[] = {senial50, destello, senial_obra, destello, texto, destello};
const int totalFrames = sizeof(frames) / sizeof(frames[0]);

void setup() {
    FastLED.addLeds<NEOPIXEL, DATA_PIN>(leds, NUM_LEDS);  // Initialize FastLED
    FastLED.setBrightness(100);
}

void loop() {
    static int currentFrame = 0;

    // Check if the current frame is a "destello"
    if (frames[currentFrame] == destello) {
        for (int blink = 0; blink < 2; blink++) {
            FastLED.clear();
            for (int i = 0; i < NUM_LEDS; i++) {
                leds[i] = pgm_read_dword(&(destello[i]));
            }
            FastLED.show();
            delay(333);  // 1/3 second
            FastLED.clear();
            FastLED.show();
            delay(333);  // 1/3 second
        }
    } else {
        // Load the current frame data
        FastLED.clear();
        for (int i = 0; i < NUM_LEDS; i++) {
            leds[i] = pgm_read_dword(&(frames[currentFrame][i]));
        }
        FastLED.show();
        delay(3000);  // Regular delay for non-destello frames
    }

    // Move to the next frame
    currentFrame++;
    if (currentFrame >= totalFrames) {
        currentFrame = 0;  // Loop back to the first frame
    }
}