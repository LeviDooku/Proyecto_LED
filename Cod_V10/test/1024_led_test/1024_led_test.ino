  for (int x = 0; x < 4; x++) {
    for (int i = 0; i < HEIGHT; i++) {
        for (int j = 0; j < WIDTH/4; j++) {
            leds[transform(i, j)] = ledarray0[i*WIDTH+(j+x*WIDTH/4)];
        }
    }
    FastLED.show();
    delay(1500);
  }
}
