// dimensiones imagen
#define WIDTH           8
#define HEIGHT          32

// dimensiones paneles
#define PANEL_WIDTH     8
#define PANEL_HEIGHT    32

int width = WIDTH;
int height = HEIGHT;
int panel_width = PANEL_WIDTH;
int panel_height = PANEL_HEIGHT;

// datos del sensor IR
IRrecv irrecv(IR_PIN);
decode_results results;

int transform(int i, int j) {
    int x = 0;

    // columnas impares
    if ((j/panel_width)%2) x = (panel_width*height*(j/panel_width)+1)+panel_width*i+panel_width-2;

    // columnas pares
    else x = (panel_width*height*(j/panel_width+1)-1)-panel_width*i;

    // filas impares
    if (i%2) x += (j%panel_width)-panel_width+1;

    // filas pares
    else x += -(j%panel_width);

    return x;
}

int sensorValue;
int sensorLow = 1023;
int sensorHigh = 0;

void setup() {
    Serial.begin(115200);
    FastLED.addLeds<NEOPIXEL, LED_PIN>(leds, NUM_LEDS);
    FastLED.clear();
    irrecv.enableIRIn(); // Inicia el receptor IR
}


typedef struct {
    int brightness;
    float temperature;
    int frame;
} sensor_data;

sensor_data sensors = {0, 0, 0};

void loop() {
    
    // Leer valores del Arduino (por comunicación serie)
    /*if (Serial.available() >= sizeof(sensor_data)) {
        Serial.readBytes((char *) &sensors, sizeof(sensor_data));
    }*/
    if (irrecv.decode(&results)) {
      //Serial.print("Código recibido: ");
      //Serial.println(results.value, HEX); // Imprime el código en formato hexadecimal
      irrecv.resume(); // Prepara el receptor para el siguiente valor
      //if (results.value == 0xFFA25D) sensors.frame = 0;
      //if (results.value == 0xFF629D) sensors.frame = 1;
      //if (results.value == 0xFFE21D) sensors.frame = 2;
    }

    Serial.println(sensors.frame);


    // Representar matrices
    for (int i = 0; i < HEIGHT; i++) {
        for (int j = 0; j < WIDTH; j++) {
            leds[transform(i, j)] = pgm_read_dword(&ledarray0[i * WIDTH + j]);

            if (sensors.frame == 0)
              leds[transform(i, j)] = pgm_read_dword(&ledarray0[i * WIDTH + j]);
            else if (sensors.frame == 1)
              leds[transform(i, j)] = pgm_read_dword(&ledarray1[i * WIDTH + j]);
            else
              leds[transform(i, j)] = pgm_read_dword(&ledarray2[i * WIDTH + j]);
        }
        FastLED.show();
    }

    // Ajustar el brillo
    FastLED.setBrightness(sensors.brightness);
    delay(100);
}
